# Database
# Application role: LOGIN, NOSUPERUSER, NOBYPASSRLS, not table owner
DATABASE_URL=postgresql://officia_app:password@localhost:5432/officia
# Migration/admin role for drizzle-kit (schema owner). Required in production.
DATABASE_MIGRATE_URL=postgresql://officia_migrate:password@localhost:5432/officia
# Local docker-compose still uses the postgres superuser until roles.sql is applied.

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# AI Services
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (Resend)
RESEND_API_KEY=re_...

# Banking Integration (Nordigen/GoCardless)
NORDIGEN_SECRET_ID=...
NORDIGEN_SECRET_KEY=...

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
